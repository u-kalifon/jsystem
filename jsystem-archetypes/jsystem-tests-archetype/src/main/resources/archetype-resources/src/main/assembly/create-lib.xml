<assembly
	xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2 http://maven.apache.org/xsd/assembly-1.1.2.xsd">
	<formats>
		<format>dir</format>
	</formats>
	<baseDirectory>..</baseDirectory>
	<includeBaseDirectory>false</includeBaseDirectory>

	<id>create-lib</id>
	<fileSets>
		<fileSet>
			<!-- Prevents assembly plugin failing when there are no jars -->
			<outputDirectory></outputDirectory>
			<directory>src/main/assembly</directory>
			<includes>
				<include>empty.txt</include>
			</includes>
		</fileSet>
	</fileSets>

	<dependencySets>
		<dependencySet>
			<excludes>
				<!-- ant/ant-launcher go to thirdparty/ant/lib/ with bare names via maven-dependency-plugin -->
				<exclude>org.apache.ant:ant:*</exclude>
				<exclude>org.apache.ant:ant-launcher:*</exclude>

				<!-- Project classes are loaded from target/classes/, not a jar -->
				<exclude>${project.groupId}:${project.artifactId}:*</exclude>
			</excludes>
		</dependencySet>
	</dependencySets>

</assembly>
